# Files left out of the package Package Control installs (GitHub archives
# honor export-ignore). The plugin only needs the .base64 images and
# stylesheet.css from resources/.
/.gitattributes             export-ignore
/.gitignore                 export-ignore
/live-testing/              export-ignore
/tests/                     export-ignore
/resources/*.png            export-ignore
/resources/*.xcf            export-ignore
/resources/convertresources.py export-ignore
